{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./gradlew:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git clone --depth 1:*)",
      "PowerShell(./gradlew:*)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:runelite.net)",
      "WebFetch(domain:static.runelite.net)",
      "WebFetch(domain:oldschool.runescape.wiki)",
      "Bash(gh api user:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh project item-list:*)",
      "Bash(gh project field-list:*)",
      "Bash(gh project view:*)",
      "Bash(bash .claude/scripts/board.sh list)",
      "Bash(bash .claude/scripts/board.sh whoami)",
      "Bash(git fetch:*)",
      "Bash(git branch:*)",
      "Bash(bash .claude/scripts/use-credentials.sh:*)"
    ],
    "deny": [
      "Bash(git push --force:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/compile-java.sh\"",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
